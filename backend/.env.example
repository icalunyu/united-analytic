# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DB_ENGINE blank for local SQLite.
# Only set DB_ENGINE=postgres in production (cPanel).
#
# PENTING, dua jebakan yang pernah makan waktu:
#
# 1. DB_ENGINE itu saklarnya. Kalau kosong/salah ketik, settings.py diam-diam
#    jatuh ke SQLite tanpa error — jadi kelihatan "jalan" padahal Postgres
#    nggak kesentuh sama sekali.
#
# 2. cPanel selalu nambahin nama akun sebagai awalan database DAN user, plus
#    ngebuang tanda hubung. Yang di UI keliatan "muanalytics" / "ical",
#    aslinya "musafarw_muanalytics" / "musafarw_ical". Nama tanpa awalan
#    bikin Postgres nolak dengan pesan menyesatkan "no pg_hba.conf entry"
#    (kesannya salah konfigurasi server, padahal cuma salah nama).
#    Cek nama aslinya: uapi Postgresql list_databases
#
# DB_HOST dikosongin = lewat Unix socket (lebih cepat, buat DB di mesin yang
# sama). Catatan: default 'localhost' di settings.py cuma berlaku kalau
# variabelnya nggak ada sama sekali, bukan kalau ada tapi kosong.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# API-Football (api-sports.io / RapidAPI)
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_KEY=
MU_TEAM_ID=33

# football-data.org (sumber alternatif, cover musim berjalan free tier)
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_MU_TEAM_ID=66

# Highlightly (squad, injuries, match events dalam 1 provider)
HIGHLIGHTLY_BASE_URL=https://soccer.highlightly.net
HIGHLIGHTLY_API_KEY=
# HIGHLIGHTLY_API_HOST cuma perlu diisi kalau daftar lewat RapidAPI marketplace
HIGHLIGHTLY_API_HOST=
HIGHLIGHTLY_MU_TEAM_ID=28867

# TheSportsDB (fallback fixtures & squad — nggak butuh signup, public test key)
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
THESPORTSDB_API_KEY=123
THESPORTSDB_MU_TEAM_ID=133612

# ESPN (match events — API internal, tidak resmi didukung pihak ketiga, nggak butuh key)
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer
ESPN_LEAGUE_SLUG=eng.1
ESPN_MU_TEAM_ID=360
ESPN_COMPETITION_SLUGS=eng.1,eng.fa,eng.league_cup,uefa.champions,uefa.europa,uefa.europa.conf,eng.charity,club.friendly

# FotMob (statistik pemain terlengkap + momentum + shotmap, nggak butuh key)
# Satu-satunya sumber gratis yang punya aksi bertahan PER PEMAIN dan umpan
# dipisah paruh sendiri/paruh lawan — dua bahan yang bikin PPDA bisa dihitung.
# Status sama kayak ESPN: API internal, tidak resmi buat pihak ketiga.
FOTMOB_BASE_URL=https://www.fotmob.com
FOTMOB_MU_TEAM_ID=10260

# Understat (xG level tembakan + xA/xGChain per pemain, nggak butuh key)
# Cuma cover 6 liga top Eropa — buat MU berarti Premier League doang.
UNDERSTAT_BASE_URL=https://understat.com
UNDERSTAT_MU_TEAM_NAME=Manchester United
UNDERSTAT_DEFAULT_SEASON=2025

# Premier League / PulseLive (match events resmi, cuma cover Premier League, nggak butuh key)
PL_BASE_URL=https://footballapi.pulselive.com/football
PL_ORIGIN_HEADER=https://www.premierleague.com
PL_MU_TEAM_ID=12
PL_COMPETITION_ID=1
